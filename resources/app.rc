#include <windows.h>
#include <commctrl.h>
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
101 DIALOGEX 0, 0, 240, 86
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "收纳盒名称"
FONT 9, "Microsoft YaHei UI"
BEGIN
  LTEXT "名称：", -1, 12, 12, 216, 10
  EDITTEXT 1001, 12, 27, 216, 16, ES_AUTOHSCROLL
  DEFPUSHBUTTON "确定", IDOK, 118, 59, 52, 16
  PUSHBUTTON "取消", IDCANCEL, 176, 59, 52, 16
END
102 DIALOGEX 0, 0, 320, 355
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "设置"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "收纳盒外观", 1120, 16, 12, 288, 20
  LTEXT "自定义窗口背景与透明效果", 1121, 16, 34, 288, 14
  LTEXT "背景", 1110, 26, 64, 260, 14
  COMBOBOX 1101, 26, 83, 268, 120, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "透明度", 1111, 26, 119, 190, 14
  LTEXT "", 1104, 256, 117, 38, 18, SS_CENTER
  CONTROL "", 1102, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | TBS_BOTH | TBS_FIXEDLENGTH | WS_TABSTOP, 26, 140, 268, 20
  LTEXT "模糊程度", 1112, 26, 176, 190, 14
  LTEXT "", 1105, 256, 174, 38, 18, SS_CENTER
  CONTROL "", 1103, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | TBS_BOTH | TBS_FIXEDLENGTH | WS_TABSTOP, 26, 196, 268, 20
  LTEXT "清晰", 1122, 29, 217, 80, 12
  RTEXT "模糊", 1123, 216, 217, 75, 12
  CONTROL "", 1132, "Static", SS_NOTIFY, 26, 257, 27, 26
  LTEXT "收纳盒图标", 1130, 64, 251, 100, 14
  LTEXT "Windows 文件夹", 1131, 64, 268, 100, 13, SS_ENDELLIPSIS
  PUSHBUTTON "选择 ICO…", 1140, 176, 251, 59, 23
  PUSHBUTTON "恢复默认", 1141, 242, 251, 51, 23
  PUSHBUTTON "打开 ICO 图标库", 1142, 201, 278, 92, 17
  PUSHBUTTON "取消", IDCANCEL, 179, 320, 59, 24
  DEFPUSHBUTTON "确定", IDOK, 245, 320, 59, 24
END
1 RT_MANIFEST "resources/app.manifest"
1 VERSIONINFO
FILEVERSION 0,4,7,0
PRODUCTVERSION 0,4,7,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "桌面收纳盒\0"
      VALUE "ProductName", "DesktopBox\0"
      VALUE "FileVersion", "0.4.7\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END

